// Este es el código fuente de un restador de 4 bits
// Com código en modelado estructural

`timescale 1ns / 1ps

//Sumador de 4-bits con el full_adder Instanciado
module PR3_2(
    input [3:0] a,
    input [3:0] b,
    input Cin,
    output [3:0] sum,
    output Cout
    );
    
    // definir nets internas
    
    wire [3:0] c;
    
    assign Cout = c[3];
    
    fullAdder FA0 (a[0], b[0], Cin, sum[0], c[0]);
    fullAdder FA1 (a[1], b[1], c[0], sum[1], c[1]);
    fullAdder FA2 (a[2], b[2], c[1], sum[2], c[2]);
    fullAdder FA3 (a[3], b[3], c[2], sum[3], c[3]);       
endmodule

//Comportamiento del full adder
module fullAdder (
input wire a, b, cin, //Entradas son del tipo wire por default
output reg sum, cout); //variables de salida son siempre reg

always @(*)
begin
    sum = a ^ b ^ cin;
    cout = (a & b) | (a & cin) | (b & cin);
end
endmodule

