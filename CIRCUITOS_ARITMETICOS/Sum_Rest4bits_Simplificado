`timescale 1ns / 1ps

module SUM_REST2_4bits(
    input  [3:0] a,          // Entrada A de 4 bits
    input  [3:0] b,          // Entrada B de 4 bits
    input  sel,        // Control: 0 = Suma, 1 = Resta
    output [3:0] dout,       // Resultado de 4 bits
    output       carry_borrow // Acarreo o préstamo de salida
);

    wire [4:0] resultado;
    
    assign resultado = (sel == 1'b1) ? (a - b) : (a + b);
        
    // Asignamos el resultado de 4 bits
    assign dout = resultado[3:0];
    
    // El bit 5 (índice 4) representa el acarreo (cout) o préstamo (borrow)
    assign carry_barrow = resultado[4];

endmodule

